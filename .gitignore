# --- OS ---
.DS_Store
Thumbs.db

# --- Dependencies ---
node_modules/
.pnpm-store/

# --- Environment & secrets ---
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
!.env.example

# --- Logs ---
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
# deploy-offline 日志目录占位需入库
!deploy-offline/logs/
!deploy-offline/logs/**/
!deploy-offline/logs/**/.gitkeep

# --- Build output ---
dist/
dist-ssr/
build/
out/
/deploy/*
!/deploy/EADAF/
!/deploy/APP/
/deploy/EADAF/**
!/deploy/EADAF/.gitkeep
/deploy/APP/**
!/deploy/APP/.gitkeep
/deploy/.staging*/
*.tsbuildinfo

# --- Offline deploy: 跟踪脚本/配置，忽略大产物 ---
# 运行时 .env（模板用 env.template）
deploy-offline/.env
# 镜像 / 静态资源 / 下载的 Docker 二进制
deploy-offline/docker-images/**
!deploy-offline/docker-images/.gitkeep
deploy-offline/frontend/dist/
deploy-offline/centos-docker-static/docker-24.0.9.tgz
deploy-offline/centos-docker-static/docker-compose
deploy-offline/centos-docker-static/docker/
# 打包时从 backend / FPCU2 拷贝的 SQL 与 seed（可再生成）
deploy-offline/init-sql/
deploy-offline/init/fpcu-seed/
# 运行日志与标记
deploy-offline/logs/**/*.log
deploy-offline/data/.initialized
deploy-offline/data/.fpcu-seeded
# 发给客户的压缩包放在 releases/ 子目录
deploy-offline/releases/**
!deploy-offline/releases/.gitkeep
# 补丁解压临时目录（若落在仓库根）
deploy-offline-patch-*/
# 兼容旧路径：根目录曾放过整包 tar
/deploy-offline-*.tar.gz

# --- Test & coverage ---
coverage/
.nyc_output/

# --- Cache ---
.cache/
.turbo/
.eslintcache
.stylelintcache
*.swp
*.swo
*~

# --- Editors ---
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln

# --- Cursor (local plans / agent state) ---
.cursor/
.offline-fpcu2-staging/
.offline-fpcu2-staging-patch/

# --- EADAF_frontend ---
frontend/tmp/

# --- backend ---
backend/uploads/*
upload_test/
!backend/uploads/.gitkeep
backend/thumbsCache/*
backend/backups/
backend/db-backup/
backend/data/*.db
backend/src/resource/
backend/install/images/*.tar
backend/img_crop_cache

# --- AIBase_with_example ---
AIBase_with_example/ref-demo/
